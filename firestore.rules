rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'gamesPlayed', 'totalSips', 'totalChugs', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('avatarIcon' in data) || (data.avatarIcon is string && data.avatarIcon.size() <= 50000)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('profiles' in data) || (data.profiles is list && data.profiles.size() <= 50)) &&
        (!('shortId' in data) || (data.shortId is string && data.shortId.size() <= 20)) &&
        (!('customShortId' in data) || (data.customShortId is string && data.customShortId.size() <= 20)) &&
        data.gamesPlayed is number && data.gamesPlayed >= 0 &&
        data.totalSips is number && data.totalSips >= 0 &&
        data.totalChugs is number && data.totalChugs >= 0 &&
        (!('duelWins' in data) || (data.duelWins is number && data.duelWins >= 0)) &&
        (!('duelPlayed' in data) || (data.duelPlayed is number && data.duelPlayed >= 0)) &&
        (!('winsBoardgame' in data) || (data.winsBoardgame is number && data.winsBoardgame >= 0)) &&
        (!('winsDuel' in data) || (data.winsDuel is number && data.winsDuel >= 0)) &&
        (!('winsCasino' in data) || (data.winsCasino is number && data.winsCasino >= 0)) &&
        (!('winsPineapple' in data) || (data.winsPineapple is number && data.winsPineapple >= 0)) &&
        (!('winsCrash' in data) || (data.winsCrash is number && data.winsCrash >= 0)) &&
        (!('totalXP' in data) || (data.totalXP is number && data.totalXP >= 0)) &&
        (!('currentLevel' in data) || (data.currentLevel is number && data.currentLevel >= 1)) &&
        (!('currentTitle_ro' in data) || (data.currentTitle_ro is string && data.currentTitle_ro.size() <= 100)) &&
        (!('currentTitle_en' in data) || (data.currentTitle_en is string && data.currentTitle_en.size() <= 100)) &&
        (!('unlockedAchievements' in data) || (data.unlockedAchievements is list && data.unlockedAchievements.size() <= 50)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Leaderboard Entry Validation (Individual Profile Entry)
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'totalSips', 'totalChugs', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('profileId' in data) || (data.profileId is string && data.profileId.size() <= 128)) &&
        (!('accountName' in data) || (data.accountName is string && data.accountName.size() <= 100)) &&
        (!('avatarIcon' in data) || (data.avatarIcon is string && data.avatarIcon.size() <= 50000)) &&
        (!('winsBoardgame' in data) || (data.winsBoardgame is number && data.winsBoardgame >= 0)) &&
        (!('winsDuel' in data) || (data.winsDuel is number && data.winsDuel >= 0)) &&
        (!('winsCasino' in data) || (data.winsCasino is number && data.winsCasino >= 0)) &&
        (!('winsPineapple' in data) || (data.winsPineapple is number && data.winsPineapple >= 0)) &&
        (!('totalScore' in data) || (data.totalScore is number && data.totalScore >= 0)) &&
        (!('totalXP' in data) || (data.totalXP is number && data.totalXP >= 0)) &&
        (!('currentLevel' in data) || (data.currentLevel is number && data.currentLevel >= 1)) &&
        (!('currentTitle_ro' in data) || (data.currentTitle_ro is string && data.currentTitle_ro.size() <= 100)) &&
        (!('currentTitle_en' in data) || (data.currentTitle_en is string && data.currentTitle_en.size() <= 100)) &&
        (!('duelWins' in data) || (data.duelWins is number && data.duelWins >= 0)) &&
        (!('duelPlayed' in data) || (data.duelPlayed is number && data.duelPlayed >= 0)) &&
        (!('gamesPlayed' in data) || (data.gamesPlayed is number && data.gamesPlayed >= 0)) &&
        data.totalSips is number && data.totalSips >= 0 &&
        data.totalChugs is number && data.totalChugs >= 0 &&
        data.updatedAt is timestamp;
    }

    // Duel History Validation
    function isValidDuelHistory(data) {
      return data.keys().hasAll(['matchId', 'roomCode', 'submode', 'difficulty', 'hostPlayerName', 'guestPlayerName', 'roundsTotal', 'creatorUid', 'createdAt']) &&
        data.matchId is string && data.matchId.size() <= 128 &&
        data.roomCode is string && data.roomCode.size() <= 10 &&
        data.submode in ['general', 'football'] &&
        data.difficulty in ['easy', 'medium', 'hard'] &&
        data.hostPlayerName is string && data.hostPlayerName.size() >= 1 && data.hostPlayerName.size() <= 50 &&
        data.guestPlayerName is string && data.guestPlayerName.size() >= 1 && data.guestPlayerName.size() <= 50 &&
        (!('winnerName' in data) || (data.winnerName is string && data.winnerName.size() <= 50)) &&
        data.roundsTotal is number && data.roundsTotal >= 0 &&
        data.creatorUid is string && data.creatorUid == request.auth.uid &&
        data.createdAt is timestamp;
    }

    // Public Profile Validation (Search index by shortId)
    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'shortId', 'displayName']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.shortId is string && data.shortId.size() >= 3 && data.shortId.size() <= 20 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('avatarIcon' in data) || (data.avatarIcon is string && data.avatarIcon.size() <= 50000)) &&
        (!('currentLevel' in data) || (data.currentLevel is number && data.currentLevel >= 1)) &&
        (!('currentTitle_ro' in data) || (data.currentTitle_ro is string && data.currentTitle_ro.size() <= 100)) &&
        (!('currentTitle_en' in data) || (data.currentTitle_en is string && data.currentTitle_en.size() <= 100)) &&
        (!('activeRoom' in data) || data.activeRoom == null || data.activeRoom is map);
    }

    // Friend Record Validation (Within user's friends subcollection)
    function isValidFriendRecord(data) {
      return data.keys().hasAll(['friendUid', 'displayName']) &&
        data.friendUid is string && data.friendUid.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('avatarIcon' in data) || (data.avatarIcon is string && data.avatarIcon.size() <= 50000)) &&
        (!('shortId' in data) || (data.shortId is string && data.shortId.size() <= 20)) &&
        (!('currentLevel' in data) || (data.currentLevel is number && data.currentLevel >= 1)) &&
        (!('currentTitle_ro' in data) || (data.currentTitle_ro is string && data.currentTitle_ro.size() <= 100)) &&
        (!('activeRoom' in data) || data.activeRoom == null || data.activeRoom is map);
    }

    // Friend Request Validation
    function isValidFriendRequest(data) {
      return data.keys().hasAll(['fromUid', 'fromName', 'toUid', 'status']) &&
        data.fromUid is string && data.fromUid == request.auth.uid &&
        data.toUid is string && data.toUid.size() <= 128 &&
        data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 100 &&
        data.status in ['pending', 'accepted', 'declined'] &&
        (!('fromAvatar' in data) || (data.fromAvatar is string && data.fromAvatar.size() <= 50000)) &&
        (!('fromShortId' in data) || (data.fromShortId is string && data.fromShortId.size() <= 20)) &&
        (!('toName' in data) || (data.toName is string && data.toName.size() <= 100)) &&
        (!('toAvatar' in data) || (data.toAvatar is string && data.toAvatar.size() <= 50000)) &&
        (!('toShortId' in data) || (data.toShortId is string && data.toShortId.size() <= 20));
    }

    // Game Invite Validation (1v1 Duel, Pineapple, Crash)
    function isValidGameInvite(data) {
      return data.keys().hasAll(['fromUid', 'fromName', 'toUid', 'mode', 'roomCode', 'status']) &&
        data.fromUid is string && data.fromUid == request.auth.uid &&
        data.toUid is string && data.toUid.size() <= 128 &&
        data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 100 &&
        data.mode in ['duel', 'pineapple', 'crash'] &&
        data.roomCode is string && data.roomCode.size() <= 10 &&
        data.status in ['pending', 'accepted', 'declined', 'expired'] &&
        (!('fromAvatar' in data) || (data.fromAvatar is string && data.fromAvatar.size() <= 50000));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles Collection & Friends Subcollection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Private profiles cannot be listed
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time;
      allow delete: if isOwner(userId);

      // User's private friends subcollection
      match /friends/{friendUid} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(friendUid) && isValidFriendRecord(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Public Profiles Directory (Search by shortId)
    match /public_profiles/{shortId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(shortId) && isValidPublicProfile(incoming()) && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }

    // Friend Requests Collection
    match /friend_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && isValidFriendRequest(incoming());
      allow update: if isSignedIn() && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
      allow delete: if isSignedIn() && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
    }

    // Direct 1v1 Game Invites Collection
    match /game_invites/{inviteId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(inviteId) && isValidGameInvite(incoming());
      allow update: if isSignedIn() && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
      allow delete: if isSignedIn() && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
    }

    // Global Leaderboard Collection (Per-profile leaderboard entries)
    match /leaderboards/{entryId} {
      allow get, list: if true; // Public tavern rankings
      allow create: if isSignedIn() &&
        isValidId(entryId) &&
        incoming().userId == request.auth.uid &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(entryId) &&
        incoming().userId == request.auth.uid &&
        existing().userId == request.auth.uid &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'antoniu.andrei.radu@gmail.com');
    }

    // Match Duel Histories Collection
    match /duel_histories/{matchId} {
      allow get, list: if true; // Public tavern duel logs
      allow create: if isSignedIn() &&
        isValidId(matchId) &&
        isValidDuelHistory(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false; // Completed duel history is immutable
    }

    // Realtime Duel Rooms Collection
    match /duel_rooms/{roomCode} {
      allow get, list: if true; // Players can lookup and join duel rooms
      allow create, update: if isValidId(roomCode);
      allow delete: if isValidId(roomCode);
    }

    // Realtime Casino Rooms Collection (2-6 Players Craps)
    match /casino_rooms/{roomCode} {
      allow get, list: if true; // Players can lookup and join casino rooms
      allow create, update: if isValidId(roomCode);
      allow delete: if isValidId(roomCode);
    }

    // Realtime Pineapple Poker Rooms Collection (2 Players OFC Pineapple)
    match /pineapple_rooms/{roomCode} {
      allow get, list: if true; // Players can lookup and join pineapple rooms
      allow create, update: if isValidId(roomCode);
      allow delete: if isValidId(roomCode);
    }

    // Realtime Crash Dragon Rooms Collection (1v1 Dragon Flight)
    match /crash_rooms/{roomCode} {
      allow get, list: if true; // Players can lookup and join crash rooms
      allow create, update: if isValidId(roomCode);
      allow delete: if isValidId(roomCode);
    }

    // Device Clock Synchronization
    match /time_sync/{syncId} {
      allow get, set, create, update, delete: if isValidId(syncId);
    }
  }
}
