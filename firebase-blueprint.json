{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile storing stats, achievements, and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User auth UID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Public player display name",
          "minLength": 1,
          "maxLength": 50
        },
        "avatarIcon": {
          "type": "string",
          "description": "Selected avatar identifier or custom photo base64",
          "maxLength": 50000
        },
        "email": {
          "type": "string",
          "description": "User email address if provided",
          "maxLength": 256
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total number of games played"
        },
        "totalSips": {
          "type": "number",
          "description": "Total sips (guri) accumulated"
        },
        "totalChugs": {
          "type": "number",
          "description": "Total chugs (gropi) accumulated"
        },
        "duelWins": {
          "type": "number",
          "description": "Total 1v1 duel victories"
        },
        "duelPlayed": {
          "type": "number",
          "description": "Total 1v1 duel matches played"
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "List of unlocked achievement IDs"
        },
        "profiles": {
          "type": "array",
          "description": "List of user profiles belonging to this Google account"
        },
        "winsBoardgame": {
          "type": "number",
          "description": "Total Monopoly wins across account"
        },
        "winsDuel": {
          "type": "number",
          "description": "Total 1v1 duel victories across account"
        },
        "winsCasino": {
          "type": "number",
          "description": "Total Casino duel victories across account"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last update"
        }
      },
      "required": ["userId", "displayName", "gamesPlayed", "totalSips", "totalChugs", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public ranking entry for global tavern drinking, monopoly, duel, and casino leaderboards per profile",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "profileId": {
          "type": "string",
          "description": "Profile identifier",
          "maxLength": 128
        },
        "accountName": {
          "type": "string",
          "description": "Google account display name",
          "maxLength": 100
        },
        "displayName": {
          "type": "string",
          "description": "Public player profile name",
          "minLength": 1,
          "maxLength": 100
        },
        "avatarIcon": {
          "type": "string",
          "description": "Avatar key or custom photo base64",
          "maxLength": 50000
        },
        "totalSips": {
          "type": "number",
          "description": "Total sips consumed"
        },
        "totalChugs": {
          "type": "number",
          "description": "Total chugs consumed"
        },
        "totalScore": {
          "type": "number",
          "description": "Calculated score: sips + chugs * 25"
        },
        "winsBoardgame": {
          "type": "number",
          "description": "Total Monopoly / Boardgame matches won"
        },
        "winsDuel": {
          "type": "number",
          "description": "Total 1v1 trivia duel matches won"
        },
        "winsCasino": {
          "type": "number",
          "description": "Total Casino Barbut craps matches won"
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total games played by this profile"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last score update"
        }
      },
      "required": ["userId", "displayName", "totalSips", "totalChugs", "updatedAt"]
    },
    "DuelHistory": {
      "title": "DuelHistory",
      "description": "Record of a completed 1v1 tavern duel match",
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "description": "Unique match identifier",
          "maxLength": 128
        },
        "roomCode": {
          "type": "string",
          "description": "Room 4-letter code",
          "maxLength": 10
        },
        "submode": {
          "type": "string",
          "description": "Submode (general, football)",
          "enum": ["general", "football"]
        },
        "difficulty": {
          "type": "string",
          "description": "Difficulty (easy, medium, hard)",
          "enum": ["easy", "medium", "hard"]
        },
        "hostPlayerName": {
          "type": "string",
          "description": "Host player name",
          "maxLength": 50
        },
        "guestPlayerName": {
          "type": "string",
          "description": "Guest player name",
          "maxLength": 50
        },
        "winnerName": {
          "type": "string",
          "description": "Winner name or null if draw",
          "maxLength": 50
        },
        "roundsTotal": {
          "type": "number",
          "description": "Number of rounds played"
        },
        "creatorUid": {
          "type": "string",
          "description": "UID of the player submitting match result",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Match end timestamp"
        }
      },
      "required": ["matchId", "roomCode", "submode", "difficulty", "hostPlayerName", "guestPlayerName", "roundsTotal", "creatorUid", "createdAt"]
    },
    "DuelRoom": {
      "title": "DuelRoom",
      "description": "Real-time 1v1 tavern duel room synchronizing game state",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Room 4-letter code",
          "maxLength": 10
        },
        "submode": {
          "type": "string",
          "description": "Submode (general, football)",
          "enum": ["general", "football"]
        },
        "difficulty": {
          "type": "string",
          "description": "Difficulty (easy, medium, hard)",
          "enum": ["easy", "medium", "hard"]
        },
        "targetPoints": {
          "type": "number",
          "description": "Target drink points limit"
        },
        "hostPlayer": {
          "type": "object",
          "description": "Host player details"
        },
        "guestPlayer": {
          "type": "object",
          "description": "Guest player details or null"
        },
        "status": {
          "type": "string",
          "description": "Room state: lobby, in_game, finished",
          "enum": ["lobby", "in_game", "finished"]
        },
        "currentRound": {
          "type": "number",
          "description": "Active round index"
        },
        "currentCardIndex": {
          "type": "number",
          "description": "Index in deck"
        },
        "deck": {
          "type": "array",
          "description": "Shuffled list of question objects for the match"
        },
        "stake": {
          "type": "object",
          "description": "Current round stake details"
        },
        "phase": {
          "type": "string",
          "description": "Active phase: reveal, race, resolution",
          "enum": ["reveal", "race", "resolution"]
        },
        "revealEndsAt": {
          "type": "number",
          "description": "Timestamp ms when question reveal countdown ends"
        },
        "lockedOutPlayerId": {
          "type": "string",
          "description": "ID of player currently locked out after a wrong answer",
          "maxLength": 128
        },
        "answeredBy": {
          "type": "string",
          "description": "Player ID who first locked in the correct answer atomically",
          "maxLength": 128
        },
        "roundResult": {
          "type": "object",
          "description": "Resolution result of current round"
        },
        "scores": {
          "type": "object",
          "description": "Scores keyed by player ID"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last room state change"
        }
      },
      "required": ["code", "submode", "difficulty", "hostPlayer", "status", "currentRound", "phase", "scores"]
    },
    "CasinoRoom": {
      "title": "CasinoRoom",
      "description": "Real-time 2-6 player tavern casino craps room state",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Room 4-letter code",
          "maxLength": 10
        },
        "startingChips": {
          "type": "number",
          "description": "Starting chip bankroll for each monk"
        },
        "hostPlayerId": {
          "type": "string",
          "description": "Host player ID",
          "maxLength": 128
        },
        "players": {
          "type": "array",
          "description": "Array of 2-6 connected casino players"
        },
        "status": {
          "type": "string",
          "description": "Room status: lobby, in_game, finished",
          "enum": ["lobby", "in_game", "finished"]
        },
        "currentRound": {
          "type": "number",
          "description": "Current round number"
        },
        "phase": {
          "type": "string",
          "description": "Round phase: penalty_reveal, betting, rolling, resolution",
          "enum": ["penalty_reveal", "betting", "rolling", "resolution"]
        },
        "phaseEndsAt": {
          "type": "number",
          "description": "Timestamp ms when phase countdown ends"
        },
        "penalty": {
          "type": "object",
          "description": "Current round drinking penalty"
        },
        "bets": {
          "type": "object",
          "description": "Active bets keyed by player ID"
        },
        "dice": {
          "type": "array",
          "description": "Rolled dice results"
        },
        "roundResult": {
          "type": "object",
          "description": "Detailed resolution outcomes for the round"
        },
        "winnerPlayer": {
          "type": "object",
          "description": "Winning player when match is finished"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last room state change"
        }
      },
      "required": ["code", "startingChips", "hostPlayerId", "players", "status", "currentRound", "phase", "bets"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private and editable user player profile"
    },
    "/leaderboards/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Publicly readable tavern leaderboard scores"
    },
    "/duel_histories/{matchId}": {
      "schema": "DuelHistory",
      "description": "Publicly readable duel game history record"
    },
    "/duel_rooms/{roomCode}": {
      "schema": "DuelRoom",
      "description": "Real-time synced duel room document"
    },
    "/casino_rooms/{roomCode}": {
      "schema": "CasinoRoom",
      "description": "Real-time synced 2-6 player casino room document"
    },
    "/time_sync/{syncId}": {
      "schema": "object",
      "description": "Device clock calibration document"
    }
  }
}
